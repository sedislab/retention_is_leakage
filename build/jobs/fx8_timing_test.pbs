#!/bin/bash
#PBS -N fx8_timing
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/build/logs/fx8_timing_test.log
set -euo pipefail
cd /data/islamm/retention_leakage/code
module load python/3.10.4
source /data/islamm/retention_leakage/envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
python3 -c "
import sys, time
sys.path.insert(0, 'src')
from p3fcl.shadow_runner import run_shadow_range

config_base = {
    'stream': {'n_tasks': 10, 'n_clients': 10, 'beta': 0.5, 'base_seed': 0},
    'targets': {'per_shard': 5, 'p_in': 0.5},
}

for method, knob, level in [('m5_hybrid_replay', 'buffer_size_per_class', 50), ('m2_target', 'n_synthetic_per_class', 50)]:
    config = {**config_base, 'method_config_override': {knob: level}}
    out_dir = f'/data/islamm/retention_leakage/shadows_v2/cifar100/{method}/dose_timing_test_{knob}_{level}/seed0'
    t0 = time.time()
    result = run_shadow_range(dataset='cifar100', method=method, start=0, count=16, workers=8, out_dir=out_dir, config=config)
    dt = time.time() - t0
    print(f'{method} {knob}={level}: 16 shadows in {dt:.1f}s ({dt/16:.2f}s/shadow avg, 8 workers)')
"
