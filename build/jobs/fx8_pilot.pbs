#!/bin/bash
#PBS -N fx8_pilot
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -J 0-1
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/build/logs/
set -euo pipefail
cd /data/islamm/retention_leakage/code
module load python/3.10.4
source /data/islamm/retention_leakage/envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

MANIFEST=/data/islamm/retention_leakage/build/waves/fx8_dose_response.tsv
# Pilot indices: row 0 (m5, level=1, seed0, chunk0) and row 145 (m2, level=1, seed0, chunk0 -- the
# first M2 row, index computed as 6 levels x 3 seeds x 8 chunks = 144 M5 rows, so M2 starts at 144).
IDX="${PBS_ARRAY_INDEX:-0}"
if [ "$IDX" = "0" ]; then REAL_IDX=0; else REAL_IDX=144; fi
LINE=$(( REAL_IDX + 2 ))
ROW=$(sed -n "${LINE}p" "$MANIFEST")
IFS=$'\t' read -r DATASET METHOD KNOB_NAME KNOB_VALUE SEED START COUNT OUT_DIR OVERRIDE <<< "$ROW"
echo "pilot row: dataset=$DATASET method=$METHOD knob=$KNOB_NAME=$KNOB_VALUE seed=$SEED start=$START count=$COUNT out=$OUT_DIR override=$OVERRIDE"

SET_ARGS=(--set stream.base_seed="${SEED}")
while IFS=$'\t' read -r K V; do
  SET_ARGS+=(--set "method_config_override.${K}=${V}")
done < <(python3 -c "
import json, sys
d = json.loads(sys.argv[1])
for k, v in d.items():
    print(f'{k}\t{json.dumps(v)}')
" "$OVERRIDE")

mkdir -p "$OUT_DIR"
time python -m p3fcl.cli shadows \
  --config configs/attack_lira.yaml \
  --dataset "$DATASET" --method "$METHOD" \
  --start "$START" --count "$COUNT" \
  --workers 8 \
  "${SET_ARGS[@]}" \
  --out "$OUT_DIR"
