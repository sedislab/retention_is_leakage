#!/bin/bash
#PBS -N m9_audit_timing
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/build/logs/fx5_m9_audit_timing.log
set -euo pipefail
cd /data/islamm/retention_leakage/code
module load python/3.10.4
source /data/islamm/retention_leakage/envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
python3 -c "
import sys, time
sys.path.insert(0, 'src')
sys.path.insert(0, 'scripts')
import run_m9_audit as m

m.N_SHADOWS = 16
m.EPS_LIST = [1.0]
t0 = time.time()
m.generate_shadows(workers=8)
print(f'wall time for 16 shadows, eps=1: {time.time()-t0:.1f}s')
"
