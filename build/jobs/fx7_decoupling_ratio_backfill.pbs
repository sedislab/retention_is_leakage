#!/bin/bash
#PBS -N fx7_decoup_backfill
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/build/logs/fx7_decoupling_ratio_backfill.log
set -euo pipefail
cd /data/islamm/retention_leakage/code
module load python/3.10.4
source /data/islamm/retention_leakage/envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

# M0 (F1, view=full, not in the FX2 manifest since it's handled separately per FX4i)
for DATASET in cifar100 cub200 imagenet_r; do
  python scripts/build_fx2_decoupling_ratio.py "$DATASET" m0_fedavg F1 full
done

# The FX2 manifest's 30 combos: 4 F1 methods x 3 datasets x view=full, 2 multiview methods x 3
# datasets x 3 views -- multiview methods' "full" view is by-construction (per-client, constant).
tail -n +2 /data/islamm/retention_leakage/build/waves/fx2_leak_main.tsv | while IFS=$'\t' read -r DATASET METHOD FAMILY VIEW SEEDS; do
  ARGS=("$DATASET" "$METHOD" "$FAMILY" "$VIEW")
  if [ "$VIEW" = "full" ] && { [ "$METHOD" = "m4_proto" ] || [ "$METHOD" = "m8_analytic" ]; }; then
    ARGS+=(--by-construction)
  fi
  python scripts/build_fx2_decoupling_ratio.py "${ARGS[@]}"
done

echo "=== done, row count ==="
wc -l /data/islamm/retention_leakage/results/decoupling_ratio.csv
