#!/bin/bash
#PBS -N fx7_prov_backfill
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/build/logs/fx7_provenance_backfill.log
set -euo pipefail
cd /data/islamm/retention_leakage/code
module load python/3.10.4
source /data/islamm/retention_leakage/envs/p3fcl/bin/activate
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2

echo "=== collect_tab05 ==="
python scripts/collect_tab05.py
echo "=== build_tab07 ==="
python scripts/build_tab07.py
echo "=== build_a1_m0_budget_check ==="
python scripts/build_a1_m0_budget_check.py
echo "=== build_fig17 ==="
python scripts/build_fig17.py
echo "=== run_m9_audit --score ==="
python scripts/run_m9_audit.py --score
echo "=== build_disjointness_report ==="
python scripts/build_disjointness_report.py
echo "=== build_fig03_dose_response ==="
python scripts/build_fig03_dose_response.py
echo "=== build_fig04_semantic_vs_individual ==="
python scripts/build_fig04_semantic_vs_individual.py
echo "=== run_fig18_report ==="
python scripts/run_fig18_report.py
echo "=== build_paper_numbers (last, so it reads the freshest state) ==="
python scripts/build_paper_numbers.py
echo "=== ALL DONE ==="
