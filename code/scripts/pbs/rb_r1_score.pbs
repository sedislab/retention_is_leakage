#!/bin/bash
#PBS -N rb_r1_score
#PBS -q batch
#PBS -l select=1:ncpus=2:mem=16gb
#PBS -l walltime=24:00:00
#PBS -J 0-29%30
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/logs/
set -euo pipefail
# Rebuttal R1 LiRA scoring + hierarchical bootstrap, one array task per (dataset, method, view).
cd /data/islamm/retention_leakage
module load python/3.10.4
source envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
python -u code/scripts/rb_r1_score.py "$PBS_ARRAY_INDEX"
