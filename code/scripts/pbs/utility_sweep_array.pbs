#!/bin/bash
#PBS -N p3_utility_sweep
#PBS -q batch
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=01:00:00
#PBS -J 0-12
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/logs/
set -uo pipefail
cd /data/islamm/retention_leakage/code

module purge
module load python/3.10.4
source /data/islamm/retention_leakage/envs/p3fcl/bin/activate
export OMP_NUM_THREADS=4
export MKL_NUM_THREADS=4

CHUNK=10
IDX="${PBS_ARRAY_INDEX:-0}"
START=$(( IDX * CHUNK ))
END=$(( START + CHUNK - 1 ))

for i in $(seq "$START" "$END"); do
  CFG=$(python scripts/grid_index.py "$i" 2>/dev/null) || { echo "index $i out of range, done"; break; }
  read -r METHOD DATASET NTASKS SEED <<< "$CFG"
  OUT_FILE="/data/islamm/retention_leakage/runs/utility_baseline/${METHOD}_${DATASET}_t${NTASKS}_s${SEED}.json"
  if [ -f "$OUT_FILE" ]; then
    echo "skip (already done): $OUT_FILE"
    continue
  fi
  echo "=== index $i: method=$METHOD dataset=$DATASET n_tasks=$NTASKS seed=$SEED ==="
  python scripts/run_utility_baseline.py --method "$METHOD" --dataset "$DATASET" --n_tasks "$NTASKS" --seed "$SEED"
done
