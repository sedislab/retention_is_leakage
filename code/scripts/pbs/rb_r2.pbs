#!/bin/bash
#PBS -N rb_r2_proj
#PBS -q batch
#PBS -l select=1:ncpus=4:mem=24gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/logs/
set -euo pipefail
# Rebuttal R2 projection ablation (rebuttal/R2_PROTOCOL.md). 3 dataset processes, single-threaded BLAS.
cd /data/islamm/retention_leakage
module load python/3.10.4
source envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
python -u code/scripts/rb_r2_projection_ablation.py
