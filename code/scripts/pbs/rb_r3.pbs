#!/bin/bash
#PBS -N rb_r3_scale
#PBS -q batch
#PBS -l select=1:ncpus=2:mem=24gb
#PBS -l walltime=48:00:00
#PBS -J 0-11%12
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/logs/
set -euo pipefail
# Rebuttal R3 client scaling (rebuttal/R3_PROTOCOL.md), one array task per (dataset, n).
cd /data/islamm/retention_leakage
module load python/3.10.4
source envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
python -u code/scripts/rb_r3_client_scaling.py "$PBS_ARRAY_INDEX"
