#!/bin/bash
#PBS -N p3_prepare
#PBS -q batch
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/logs/
set -euo pipefail
cd /data/islamm/retention_leakage/code

module purge
module load python/3.10.4
source /data/islamm/retention_leakage/envs/p3fcl/bin/activate

python -m p3fcl.cli data --prepare --dataset "${DATASET}"
python -m p3fcl.cli data --audit --dataset "${DATASET}"
