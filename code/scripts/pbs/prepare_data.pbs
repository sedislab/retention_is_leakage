#!/bin/bash
#PBS -N p3_prepare
#PBS -q batch
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o logs/
set -euo pipefail
cd $PBS_O_WORKDIR/code

module purge
module load python/3.10.4
source $PBS_O_WORKDIR/envs/p3fcl/bin/activate

python -m p3fcl.cli data --prepare --dataset "${DATASET}"
python -m p3fcl.cli data --audit --dataset "${DATASET}"
