#!/bin/bash
#PBS -N rb_r1_equiv
#PBS -q batch
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/logs/
set -euo pipefail
# Rebuttal R1 equivalence gate (rebuttal/R1_PROTOCOL.md). Exit 1 on any mismatch -> the
# afterok-dependent shadow array never starts.
cd /data/islamm/retention_leakage
module load python/3.10.4
source envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
python -u code/scripts/rb_r1_equivalence.py
