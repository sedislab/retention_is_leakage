#!/bin/bash
#PBS -N p3_gram_inv
#PBS -q batch
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/
set -euo pipefail
cd $PBS_O_WORKDIR/code

module purge
module load python/3.10.4
source $PBS_O_WORKDIR/envs/p3fcl/bin/activate
export OMP_NUM_THREADS=4

python scripts/run_gram_inversion.py cub200 cifar100
