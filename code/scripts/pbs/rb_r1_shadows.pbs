#!/bin/bash
#PBS -N rb_r1_shadows
#PBS -q batch
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=12:00:00
#PBS -J 0-17%20
#PBS -j oe
#PBS -o /data/islamm/retention_leakage/logs/
set -euo pipefail
# Rebuttal R1 release-only shadow scores, one array task per (dataset, method, seed).
cd /data/islamm/retention_leakage
module load python/3.10.4
source envs/p3fcl/bin/activate
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
python -u code/scripts/rb_r1_release_shadows.py "$PBS_ARRAY_INDEX"
